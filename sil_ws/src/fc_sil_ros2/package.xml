<?xml version="1.0"?>
<package format="3">
  <name>fc_sil_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 Jazzy SIL adapter for the esp32_FC six-motor flight controller.</description>
  <maintainer email="maintainer@example.com">esp32_FC developer</maintainer>
  <license>NOASSERTION</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>actuator_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
